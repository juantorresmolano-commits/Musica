# Copia este archivo como .env y completa los datos reales de MongoDB Atlas.
DB_NAME=escuela_musica
MONGODB_URI=

# En Atlas: Connect > Drivers > Node.js. Pega la URI mongodb+srv://...
# Sustituye <db_username> y <db_password> en esa URI por las credenciales
# de un usuario de base de datos. No publiques el archivo .env.
